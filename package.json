{
  "name": "balian-dev",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "npm run lint:copy && npm run lint:seo && astro build && node scripts/headers.mjs",
    "preview": "astro preview --port 4322",
    "check": "astro check",
    "pages:dev": "npm run build && wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist --project-name balian-dev --branch main",
    "og": "node scripts/og.mjs",
    "lint:copy": "node --experimental-strip-types scripts/lint-copy.ts",
    "lint:seo": "node --experimental-strip-types scripts/lint-seo.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/sora": "^5.2.0",
    "astro": "^5.14.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
