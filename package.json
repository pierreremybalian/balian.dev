{
  "name": "balian-dev",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "node scripts/lint-copy.ts && node scripts/lint-seo.ts && astro build",
    "preview": "astro preview --port 4322",
    "check": "astro check",
    "pages:dev": "astro build && wrangler pages dev dist",
    "deploy": "astro build && wrangler pages deploy dist --project-name balian-dev --branch main",
    "lint:copy": "node scripts/lint-copy.ts",
    "lint:seo": "node scripts/lint-seo.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/sora": "^5.2.0",
    "astro": "^5.14.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.42.0"
  }
}
