---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { stacks } from "../data/skills";
import { serviceGroups } from "../data/services";
import { generalFaq } from "../data/faq";
import { aboutPage, breadcrumbs } from "../lib/schema";
import { seo } from "../data/seo";
import { copy } from "../data/ledes";
import { SINCE, sinceText } from "../lib/since";

// Past work is described by kind. No employer or client names, no figures. See CONTENT.md, "Proof policy".
const experience = [
  { t: "Led a web team.", p: "As director of web technology and security at a Minneapolis agency I reviewed the code, set the standards, ran the hosting and the security program, and scoped the larger engagements from feasibility through system design." },
  { t: "Built and ran stores.", p: "Re-platformed a manufacturer from a proprietary commerce SaaS to WooCommerce with a Sage 100 integration. Moved a specialty retailer off BigCommerce, cleaned up a large catalog, and added QuickBooks and point-of-sale sync. Owned payments, tax and EDI across many stores." },
  { t: "Kept sites secure and up.", p: "Administered Cloudflare WAF and DNS for a large client portfolio, led incident response and cleanup for compromised sites, and ran cyber-insurance audit remediation." },
  { t: "Made sites usable and findable.", p: "Dozens of WCAG AA remediations, performance work against Core Web Vitals, SEO rebuilds after migrations, email deliverability, and HIPAA-scoped sites." },
  { t: "Started on my own.", p: "Before agency life I co-owned a small design and build studio, handling design, development and hosting for long-term clients." },
];
const ai = [
  { t: "AI handles the typing.", p: "Drafting, scaffolding, testing and documentation that once took a team now take one engineer directing capable tools." },
  { t: "Experience keeps it safe.", p: "I can read the code, see when the AI is heading the wrong way, and correct it." },
  { t: "You get the benefit.", p: "Faster delivery, a lower cost, and the person doing the work in every conversation." },
];
---
<Base
  title={seo.about.title}
  description={seo.about.description}
  schema={[aboutPage(), breadcrumbs([{ name: "Home", path: "/" }, { name: "About", path: "/about/" }])]}
>
  <section class="phero">
    <div class="in">
      <p class="crumb">About</p>
      <h1>{copy.about.h1}</h1>
      <p class="lede">{copy.about.lede}</p>
      <p class="since">For the record, I have been freelancing again for <span id="since" data-since={SINCE}>{sinceText(new Date())}</span>.</p>
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">Experience</span>
      <h2>What I have done.</h2>
      <ul class="items" style="max-width:none;margin-top:48px">
        {experience.map((m) => <li class="rv"><b style="font-size:1.35rem">{m.t}</b><span style="font-size:17px">{m.p}</span></li>)}
      </ul>
      <p class="intro" style="margin-top:36px">Clients have included manufacturers, specialty retailers, grocery and regional retail brands, healthcare organisations with HIPAA obligations, and many B2C brands.</p>
      <ul class="stack" style="margin-top:32px" aria-label="Stacks I work in">{stacks.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">What I offer</span>
      <h2>What you can hire me for.</h2>
      <p class="intro">Most projects mix two or three of these, and I do all of them myself, from the first call to launch and support.</p>
      <ul class="items" style="max-width:none;margin-top:40px">
        {serviceGroups.map((g) => <li class="rv"><a href={g.href}><b style="font-size:1.2rem">{g.name}</b></a><span style="font-size:17px">{g.short}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">How I work now</span>
      <h2>Why one person can do what a team did.</h2>
      <ul class="items" style="max-width:none;margin-top:48px">
        {ai.map((m) => <li class="rv"><b style="font-size:1.35rem">{m.t}</b><span style="font-size:17px">{m.p}</span></li>)}
      </ul>
      <p class="intro" style="margin-top:36px">Every project follows the same stages an agency would run, with your approval at each gate. <a class="lnk" href="/process/">See the process</a></p>
    </div>
  </section>

  <div class="in">
    <section class="prose">
      <h2>Where this model is not the right fit</h2>
      <div class="body rv">
        <p>One person is the wrong choice for some work, and I would sooner say so than take it.</p>
        <ul class="plainlist">
          <li>Large programs with many parallel workstreams and hard simultaneous deadlines</li>
          <li>Round-the-clock operations coverage</li>
          <li>Procurement that requires a vendor of a particular size</li>
        </ul>
      </div>
    </section>
    <section class="prose">
      <h2>What if I am unavailable?</h2>
      <div class="body rv">
        <p>It is the fair question to ask about a solo engineer, and the answer is built into how I work.</p>
        <ul class="plainlist">
          <li>You own the code, the repositories and the accounts</li>
          <li>Everything is documented for the next engineer who opens it</li>
          <li>Automated tests protect the behaviour that matters</li>
          <li>Handover is a stage in the process with its own deliverable</li>
        </ul>
      </div>
    </section>
  </div>

  <Faq items={generalFaq} />
  <CtaBand />

  <script>
    import { sinceText } from "../lib/since";
    // the build-time value is right for anyone without JS; with JS it ticks
    const el = document.getElementById("since");
    if (el) {
      const start = new Date(el.dataset.since!);
      const tick = () => { el.textContent = sinceText(new Date(), start); };
      tick();
      setInterval(tick, 1000);
    }
  </script>
</Base>
