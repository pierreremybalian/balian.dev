---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { stacks } from "../data/skills";
import { serviceGroups } from "../data/services";
import { generalFaq } from "../data/faq";
import { aboutPage, breadcrumbs } from "../lib/schema";
import { seo } from "../data/seo";
import { copy } from "../data/ledes";

const experience = [
  { t: "More than fifteen years in agency environments.", p: "I have worked professionally on agency teams since before the current tools existed, taking projects from the first scoping call through design, build, launch and support." },
  { t: "Many industries and many kinds of client.", p: "Different businesses have different rules, audiences and risks. I have built for a wide range of them, and I start by learning how yours makes money before I choose a tool." },
  { t: "Still hands on.", p: "I write and read the code myself, in TypeScript, PHP, Python and SQL, on WordPress, Next.js, Astro and Cloudflare. I have not moved into managing other people's work." },
  { t: "Products of my own.", p: "I build and run ZoneSteward and CookieSteward, so I know what it takes to keep software working after launch." },
];
const ai = [
  { t: "AI handles the typing.", p: "Drafting, scaffolding, testing and documentation that once took a team now take one engineer directing capable tools." },
  { t: "Experience keeps it safe.", p: "I can read the code, see when the AI is heading the wrong way, and correct it." },
  { t: "You get the benefit.", p: "Faster delivery, a lower cost, and the person doing the work in every conversation." },
];
---
<Base
  title={seo.about.title}
  description={seo.about.description}
  schema={[aboutPage(), breadcrumbs([{ name: "Home", path: "/" }, { name: "About", path: "/about/" }])]}
>
  <section class="phero">
    <div class="in">
      <p class="crumb">About</p>
      <h1>{copy.about.h1}</h1>
      <p class="lede">{copy.about.lede}</p>
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">Experience</span>
      <h2>What fifteen years in agencies adds up to.</h2>
      <ul class="items" style="max-width:none;margin-top:48px">
        {experience.map((m) => <li class="rv"><b style="font-size:1.35rem">{m.t}</b><span style="font-size:17px">{m.p}</span></li>)}
      </ul>
      <ul class="stack" style="margin-top:40px">{stacks.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">What I offer</span>
      <h2>What you can hire me for.</h2>
      <p class="intro">Most projects mix two or three of these, and I do all of them myself, from the first call to launch and support.</p>
      <ul class="items" style="max-width:none;margin-top:40px">
        {serviceGroups.map((g) => <li class="rv"><a href={g.href}><b style="font-size:1.2rem">{g.name}</b></a><span style="font-size:17px">{g.short}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">How I use AI</span>
      <h2>Why one person can do the work of a team.</h2>
      <ul class="items" style="max-width:none;margin-top:48px">
        {ai.map((m) => <li class="rv"><b style="font-size:1.35rem">{m.t}</b><span style="font-size:17px">{m.p}</span></li>)}
      </ul>
      <p class="intro" style="margin-top:36px">Every project follows the same stages an agency would run, with your approval at each gate. <a class="lnk" href="/process/">See the process</a></p>
    </div>
  </section>

  <div class="in">
    <section class="prose">
      <h2>Where this model is not the right fit</h2>
      <div class="body rv">
        <p>One person is the wrong choice for some work, and I would rather say so than take it.</p>
        <ul class="plainlist">
          <li>Large programs with many parallel workstreams and hard simultaneous deadlines</li>
          <li>Round-the-clock operations coverage</li>
          <li>Procurement that requires a vendor of a particular size</li>
        </ul>
      </div>
    </section>
    <section class="prose">
      <h2>What if I am unavailable?</h2>
      <div class="body rv">
        <p>It is the fair question to ask about a solo engineer, and the answer is built into how I work.</p>
        <ul class="plainlist">
          <li>You own the code, the repositories and the accounts</li>
          <li>Everything is documented for the next engineer, not for me</li>
          <li>Automated tests protect the behaviour that matters</li>
          <li>Handover is a defined step, not an afterthought</li>
        </ul>
      </div>
    </section>
    <section class="prose">
      <h2>Why there is not more to show</h2>
      <div class="body rv">
        <p>Most of what I built in agency work belongs to the clients and the agencies, so I cannot show it here, and I will not pass it off as my own.</p>
        <p>What I can show is the software I build on my own time and the way I work. If you want to know what fifteen years of production work looks like, ask me on a call.</p>
      </div>
    </section>
  </div>

  <Faq items={generalFaq} />
  <CtaBand />
</Base>
