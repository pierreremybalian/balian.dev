---
import Base from "../layouts/Base.astro";
---
<Base title="Page Not Found" description="That page does not exist." noindex>
  <section class="phero">
    <div class="in">
      <p class="crumb">404</p>
      <h1>That page is not here.</h1>
      <p class="lede">It may have moved, or the link may be wrong. These are good places to start.</p>
      <div class="btns"><a class="btn" href="/">Home</a><a class="lnk" href="/services/">Services</a><a class="lnk" href="/contact/">Contact</a></div>
    </div>
  </section>
</Base>
