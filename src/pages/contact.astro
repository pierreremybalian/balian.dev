---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { contactPage, breadcrumbs } from "../lib/schema";
import { seo } from "../data/seo";
import { copy } from "../data/ledes";
---
<Base
  title={seo.contact.title}
  description={seo.contact.description}
  schema={[contactPage(), breadcrumbs([{ name: "Home", path: "/" }, { name: "Contact", path: "/contact/" }])]}
>
  <section class="phero">
    <div class="in">
      <p class="crumb">Contact</p>
      <h1>{copy.contact.h1}</h1>
      <p class="lede">{copy.contact.lede}</p>
      <div class="btns"><a class="btn" href="#book">Book a 30-minute call</a></div>
    </div>
  </section>

  <section class="sec" id="book">
    <div class="in">
      <span class="label">Book a call</span>
      <h2 style="margin-bottom:12px">Pick a 30-minute slot.</h2>
      <p class="note" id="book-note">Times are shown in your time zone. Calls are on Google Meet.</p>
      <div class="book">
        <div class="group"><span class="label" id="book-days-label">Day</span><div class="days" id="book-days" aria-labelledby="book-days-label"></div></div>
        <div class="group"><span class="label" id="book-slots-label">Time</span><div class="slots" id="book-slots" aria-labelledby="book-slots-label"><span class="note">Loading open days...</span></div></div>
        <p class="note" id="book-empty" hidden>No open slots in the next three weeks. Email me and we will find one.</p>
        <form class="form" id="book-form" hidden novalidate>
          <p class="chosen" id="book-chosen"></p>
          <div class="field"><label for="book-name">Name <span class="req" aria-hidden="true">*</span></label><input id="book-name" name="name" type="text" autocomplete="name" required aria-required="true" /></div>
          <div class="field"><label for="book-email">Email <span class="req" aria-hidden="true">*</span></label><input id="book-email" name="email" type="email" autocomplete="email" required aria-required="true" /></div>
          <div class="two-up">
            <div class="field"><label for="book-company">Company</label><input id="book-company" name="company" type="text" autocomplete="organization" /></div>
            <div class="field"><label for="book-site">Website</label><input id="book-site" name="site" type="url" inputmode="url" autocomplete="url" placeholder="https://" /></div>
          </div>
          <div class="two-up">
            <div class="field"><label for="book-phone">Phone</label><input id="book-phone" name="phone" type="tel" autocomplete="tel" /></div>
            <div class="field"><label for="book-kind">What are you looking for?</label>
              <select id="book-kind" name="kind">
                <option>A new website or rebuild</option>
                <option>An online store</option>
                <option>A web app or SaaS product</option>
                <option>An AI feature</option>
                <option>An integration or internal tool</option>
                <option>Overflow work for my agency</option>
                <option>Something else</option>
              </select></div>
          </div>
          <div class="field"><label for="book-note-text">What should we talk about?</label><textarea id="book-note-text" name="note" style="min-height:100px"></textarea></div>
          <div class="hp" aria-hidden="true"><label for="book-fax">Fax</label><input id="book-fax" name="fax" type="text" tabindex="-1" autocomplete="off" /></div>
          <div class="btns"><button class="btn" type="submit" style="border:0;cursor:pointer">Confirm the call</button><a class="lnk" href="#book" id="book-change">Pick another time</a><span id="book-status" class="note" role="status" aria-live="polite" aria-atomic="true"></span></div>
          <p class="note">The invite comes from Google Calendar with a Meet link. I use your details only for the call.</p>
        </form>
        <p class="done" id="book-done" hidden tabindex="-1" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="sec" id="direct">
    <div class="in">
      <span class="label">Reach me directly</span>
      <h2 style="margin-bottom:40px">The quickest way is the plain one.</h2>
      <ul class="direct">
        <li><span class="label">Email</span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><span class="label">Phone</span><a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a></li>
        <li><span class="label">LinkedIn</span><a href={site.contact.linkedin} rel="noopener me">{site.contact.linkedinLabel}</a></li>
        <li><span class="label">Based in</span><span class="v">{site.location}, working remotely</span></li>
      </ul>
      <p class="note" style="margin-top:20px">Email is best for a first note. If you call and I miss it, leave a message and I will call back.</p>
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">Prefer to write it down?</span>
      <h2 style="margin-bottom:40px">A few lines is plenty.</h2>
      <form class="form" id="contact-form" method="post" action="/api/contact" novalidate>
        <div class="field"><label for="name">Name <span class="req" aria-hidden="true">*</span></label><input id="name" name="name" type="text" autocomplete="name" required aria-required="true" /></div>
        <div class="field"><label for="email">Email <span class="req" aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required aria-required="true" /></div>
        <div class="field"><label for="kind">What are you looking for?</label>
          <select id="kind" name="kind">
            <option>A new website or rebuild</option>
            <option>An online store</option>
            <option>A web app or SaaS product</option>
            <option>An AI feature</option>
            <option>An integration or internal tool</option>
            <option>Overflow work for my agency</option>
            <option>Something else</option>
          </select></div>
        <div class="field"><label for="message">About the project <span class="req" aria-hidden="true">*</span></label><textarea id="message" name="message" required aria-required="true" minlength="10"></textarea></div>
        <div class="hp" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
        <div class="btns"><button class="btn" type="submit" style="border:0;cursor:pointer">Send brief</button><span id="form-status" class="note" role="status" aria-live="polite" aria-atomic="true"></span></div>
        <p class="note"><span class="req" aria-hidden="true">*</span> Required. I use what you send only to reply to you.</p>
      </form>
    </div>
  </section>

  <script>
    import { initBooking } from "../scripts/booking";
    initBooking();

    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("form-status");
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]"));
      fields.forEach((f) => f.removeAttribute("aria-invalid"));
      const bad = fields.filter((f) => !f.checkValidity());
      if (bad.length) {
        bad.forEach((f) => f.setAttribute("aria-invalid", "true"));
        if (status) status.textContent = "Please fix the highlighted field" + (bad.length > 1 ? "s" : "") + ".";
        bad[0].focus();
        return;
      }
      if (status) status.textContent = "Sending...";
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          form.reset();
          if (status) status.innerHTML = 'Sent. I will reply personally. While you wait, <a class="lnk" href="/intake/">the project questionnaire</a> tells me most of what I need.';
        } else if (status) {
          status.textContent = data.error || "That did not send. Please try again, or book a call above.";
        }
      } catch {
        if (status) status.textContent = "That did not send. Please try again, or book a call above.";
      }
    });
  </script>
</Base>
