---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import Timeline from "../components/Timeline.astro";
import { stages } from "../data/process";
import { breadcrumbs, faqPage } from "../lib/schema";
import { copy } from "../data/ledes";
import { seo } from "../data/seo";
import type { Faq as FaqItem } from "../data/faq";

const faq: FaqItem[] = [
  { q: "How long does a project take?", a: "It depends on scope, and the proposal states a timeline you can approve. The gates are there so that timeline is based on decisions you have already made." },
  { q: "What if I do not like any of the three directions?", a: "Say so and say why. The feedback shapes the next round, and you are not charged for being specific about what is wrong. Often the answer is a mix of parts from two directions." },
  { q: "How many revision rounds do I get?", a: "Two, on the staging site, each one a single consolidated list from your approver. The rounds are for fixing anything that does not match the design you approved. New requests are welcome and go on the Phase 2 list, to be quoted after launch." },
  { q: "What is the difference between a fix and a change?", a: "A fix is something that does not match what you approved, like a wrong colour or a block that does not behave as designed. A change is a new preference or a new feature. Fixes are included. Changes are quoted, and most of them are better done after launch anyway, when you have seen the site in use." },
  { q: "What if we think of something halfway through?", a: "Tell me. It goes on the Phase 2 list with a rough estimate, the build keeps moving, and once the site is live and paid for I quote the list. Scope creep is how projects go over, so I treat it as a separate phase instead of pretending it is free." },
  { q: "Do we have to write the content?", a: "No. I write it from a recorded interview and the materials you already have, and you correct facts on the staging site. If you have a writer you trust, they work inside the page briefs and I edit for fit." },
  { q: "Can we skip stages?", a: "Some projects compress them, but design before build and your approval at the gates stay. They are what keep the cost of changes low." },
  { q: "Does this work for a web app as well as a website?", a: "Yes. Content and copy stages give way to product scoping and iterative delivery, and the design gates stay the same." },
];
const gates = stages.filter((s) => s.gate).length;
---
<Base
  title={seo.process.title}
  description={seo.process.description}
  schema={[faqPage(faq), breadcrumbs([{ name: "Home", path: "/" }, { name: "Process", path: "/process/" }])]}
>
  <section class="phero">
    <div class="in">
      <p class="crumb">Process</p>
      <h1>{copy.process.h1}</h1>
      <p class="lede">{copy.process.lede}</p>
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">The stages</span>
      <h2>What happens, and what you get.</h2>
      <Timeline detailed />
    </div>
  </section>

  <section class="sec">
    <div class="in">
      <span class="label">Design before build</span>
      <h2>Why the design stages come first.</h2>
      <div class="pgrid rv" style="margin-top:48px">
        <div class="pcell"><h3>Three real choices</h3><p>The styleframes use your actual content and differ in mood, type and layout. You react to something concrete instead of a mood board.</p></div>
        <div class="pcell"><h3>A system and its blocks</h3><p>I design the system and the blocks pages are built from, then let the build produce the pages. Mocking up every page is where projects drown in preference.</p></div>
        <div class="pcell"><h3>Cheap to change, then expensive</h3><p>Changing a design is quick. Changing a built site is not. The gates put the decisions where changes cost least.</p></div>
      </div>
    </div>
  </section>

  <div class="in">
    <section class="prose">
      <h2>You will never be handed a blank page.</h2>
      <div class="body rv">
        <p>Most websites stall on the words. Copywriting is expensive, so the job goes to whoever on your team seems to have time. That person turns out not to have the time, has never written a website, was not in the room when the goals were set, and does not know the block system the pages are built from. Three weeks later I get a Word document and a question about how to center a section.</p>
        <p>So I write it. I ran discovery, I know what the site is for, and AI drafts faster than anyone types. You give me an hour on a recorded call and whatever you already have: brochures, decks, the old site, sales emails, reviews. I turn that into every page, fitted to the blocks, and you correct facts on the staging site. If you have a writer you trust, they work inside the page briefs and I edit for fit.</p>
      </div>
    </section>
  </div>

  <Faq items={faq} />
  <CtaBand heading="Ready to start with a call?" />
</Base>
