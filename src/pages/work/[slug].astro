---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { caseStudies } from "../../data/work";
import { breadcrumbs, softwareApp } from "../../lib/schema";
import { seo } from "../../data/seo";

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const path = `/work/${c.slug}/`;
const meta = seo[c.slug];
---
<Base
  title={meta.title}
  description={meta.description}
  schema={[softwareApp(c.name, meta.description, path, c.external?.href), breadcrumbs([{ name: "Home", path: "/" }, { name: "Work", path: "/work/" }, { name: c.name, path }])]}
>
  <section class="phero">
    <div class="in">
      <p class="crumb"><a href="/work/">Work</a></p>
      <div class="statusbar"><span class="pill sig">{c.status}</span></div>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
      {c.external && <div class="btns"><a class="btn ghost" href={c.external.href} rel="noopener">{c.external.label}</a></div>}
    </div>
  </section>

  <section class="sec" style="padding-block:60px">
    <div class="in">
      <ul class="items" style="max-width:none">
        {c.facts.map((f) => <li><b>{f.k}</b><span>{f.v}</span></li>)}
      </ul>
    </div>
  </section>

  <div class="in">
    {c.sections.map((s) => (
      <section class="prose">
        <h2>{s.h2}</h2>
        <div class="body rv">
          {s.paras?.map((p) => <p>{p}</p>)}
          {s.bullets && <ul class="plainlist">{s.bullets.map((b) => <li>{b}</li>)}</ul>}
        </div>
      </section>
    ))}
  </div>

  {c.slug === "zonesteward" && (
    <section class="sec" style="padding-block:70px">
      <div class="in">
        <span class="label">The approval gate</span>
        <div class="diagram rv" style="margin-top:24px">
          <svg viewBox="0 0 900 140" role="img" aria-label="Five steps: the model proposes a change, the server validates and queues it, a person approves, the change is applied, the result is verified against live state.">
            <defs><marker id="ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#5a6482"/></marker></defs>
            <rect class="bx" x="2" y="38" width="150" height="64" rx="4"/><text x="77" y="66" text-anchor="middle">Model</text><text x="77" y="84" text-anchor="middle">proposes</text>
            <rect class="bx" x="190" y="38" width="150" height="64" rx="4"/><text x="265" y="66" text-anchor="middle">Server validates</text><text x="265" y="84" text-anchor="middle">and queues</text>
            <rect class="hi" x="378" y="38" width="150" height="64" rx="4"/><text x="453" y="66" text-anchor="middle">A person</text><text x="453" y="84" text-anchor="middle">approves</text>
            <rect class="bx" x="566" y="38" width="150" height="64" rx="4"/><text x="641" y="66" text-anchor="middle">Change is</text><text x="641" y="84" text-anchor="middle">applied</text>
            <rect class="bx" x="754" y="38" width="144" height="64" rx="4"/><text x="826" y="66" text-anchor="middle">Verified against</text><text x="826" y="84" text-anchor="middle">live state</text>
            <path class="ln" d="M152 70H188" marker-end="url(#ah)"/><path class="ln" d="M340 70H376" marker-end="url(#ah)"/><path class="ln" d="M528 70H564" marker-end="url(#ah)"/><path class="ln" d="M716 70H752" marker-end="url(#ah)"/>
            <text class="cap" x="77" y="22" text-anchor="middle">no write access</text>
            <text class="cap" x="453" y="22" text-anchor="middle">the only gate</text>
            <text class="cap" x="898" y="128" text-anchor="end">verified afterward</text>
          </svg>
        </div>
      </div>
    </section>
  )}

  {c.slug === "cookiesteward" && (
    <section class="sec" style="padding-block:70px">
      <div class="in">
        <span class="label">Consent path</span>
        <div class="diagram rv" style="margin-top:24px">
          <svg viewBox="0 0 900 140" role="img" aria-label="Visitor's browser runs the banner, an edge Worker serves configuration from KV, consent receipts go through a queue into D1.">
            <defs><marker id="ah2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#5a6482"/></marker></defs>
            <rect class="bx" x="2" y="38" width="170" height="64" rx="4"/><text x="87" y="66" text-anchor="middle">Banner runtime</text><text x="87" y="84" text-anchor="middle">in the browser</text>
            <rect class="hi" x="226" y="38" width="170" height="64" rx="4"/><text x="311" y="66" text-anchor="middle">Edge Worker</text><text x="311" y="84" text-anchor="middle">config from KV</text>
            <rect class="bx" x="450" y="38" width="170" height="64" rx="4"/><text x="535" y="66" text-anchor="middle">Queue</text><text x="535" y="84" text-anchor="middle">consent writes</text>
            <rect class="bx" x="674" y="38" width="170" height="64" rx="4"/><text x="759" y="66" text-anchor="middle">D1 receipts</text><text x="759" y="84" text-anchor="middle">dead-letter queue</text>
            <path class="ln" d="M172 70H224" marker-end="url(#ah2)"/><path class="ln" d="M396 70H448" marker-end="url(#ah2)"/><path class="ln" d="M620 70H672" marker-end="url(#ah2)"/>
            <text class="cap" x="87" y="22" text-anchor="middle">about 7 KB gzipped</text>
            <text class="cap" x="759" y="128" text-anchor="middle">failures are kept</text>
          </svg>
        </div>
      </div>
    </section>
  )}

  <section class="pwrap">
    <div class="in">
      <h2>Related</h2>
      <div class="related">{c.related.map((r) => <a href={r.href}>{r.label}</a>)}</div>
    </div>
  </section>

  <CtaBand heading="Want a product built this way?" />
</Base>
