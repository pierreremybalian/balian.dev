---
import "../styles/global.css";
import Rail from "../components/Rail.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { TITLE_SUFFIX } from "../data/seo";

interface Props {
  title: string;
  description: string;
  schema?: object[];
  noindex?: boolean;
  home?: boolean;
}
const { title, description, schema = [], noindex = false, home = false } = Astro.props;
const fullTitle = `${title}${TITLE_SUFFIX}`;
const ogImage = new URL("/og.png?v=2", site.url).toString();
const canonical = new URL(Astro.url.pathname, site.url).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#090b10" />
    <meta name="google-site-verification" content="d83qAyrXmdeerRyimM8C57WkCfzOkzTiTqQKY6E3uKU" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Balian.dev: agency-level web engineering, without the agency." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.add("js");try{if(localStorage.getItem("motion")==="off")document.documentElement.dataset.motion="off";}catch(e){}</script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Rail />
    <main id="main" tabindex="-1">
      <slot />
      <div class="in"><Footer /></div>
    </main>
    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
