---
import type { Faq } from "../data/faq";
interface Props { items: Faq[]; label?: string }
const { items, label = "Questions" } = Astro.props;
---
<section class="sec" id="faq">
  <div class="in fgrid">
    <div class="label">{label}</div>
    <div>
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
