---
import { nav, site } from "../data/site";
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const inServices = path.startsWith("/services/");
---
<header class="rail">
  <a class="mark" href="/" aria-label={`${site.brand} home`}><i></i>Balian<span class="tld">.dev</span></a>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mpanel" id="menu-btn">Menu</button>
  <nav class="rnav" aria-label="Primary">
    {nav.map((item) => (
      <>
        <a href={item.href} aria-current={isCurrent(item.href) && (item.href !== "/services/" || path === "/services/") ? "page" : undefined} class={isCurrent(item.href) ? "on" : undefined}>{item.label}</a>
        {item.children && inServices && (
          <div class="sub">
            {item.children.map((c) => (
              <a href={c.href} aria-current={path === c.href ? "page" : undefined}>{c.label}</a>
            ))}
          </div>
        )}
      </>
    ))}
  </nav>
  <div class="rfoot">
    <span>{site.location} · remote</span>
    <a class="rbtn" href={site.bookingUrl}>Book a call</a>
  </div>
</header>
<nav class="mpanel" id="mpanel" aria-label="Menu">
  {nav.map((item) => (
    <>
      <a href={item.href} aria-current={isCurrent(item.href) && (item.href !== "/services/" || path === "/services/") ? "page" : undefined}>{item.label}</a>
      {item.children?.map((c) => <a class="sub" href={c.href} aria-current={path === c.href ? "page" : undefined}>{c.label}</a>)}
    </>
  ))}
  <a class="rbtn" href={site.bookingUrl}>Book a call</a>
</nav>
